{
  "environments": {
    "dev": {
      "base_url": "https://dev-api.example.com",
      "oauth": {
        "token_url": "https://dev-auth.example.com/oauth/token",
        "client_id": "dev_client_id",
        "client_secret": "dev_client_secret"
      },
      "api_keys": {
        "x_api_key": "your_dev_api_key_here"
      }
    },
    "qa": {
      "base_url": "https://qa-api.example.com",
      "oauth": {
        "token_url": "https://qa-auth.example.com/oauth/token",
        "client_id": "qa_client_id",
        "client_secret": "qa_client_secret"
      },
      "api_keys": {
        "x_api_key": "your_qa_api_key_here"
      }
    },
    "uat": {
      "base_url": "https://uat-api.example.com",
      "oauth": {
        "token_url": "https://uat-auth.example.com/oauth/token",
        "client_id": "uat_client_id",
        "client_secret": "uat_client_secret"
      },
      "api_keys": {
        "x_api_key": "your_uat_api_key_here"
      }
    },
    "prod": {
      "base_url": "https://api.example.com",
      "oauth": {
        "token_url": "https://auth.example.com/oauth/token",
        "client_id": "prod_client_id",
        "client_secret": "prod_client_secret"
      },
      "api_keys": {
        "x_api_key": "your_prod_api_key_here"
      }
    }
  },
  "database": {
    "host": "localhost",
    "port": 5432,
    "username": "db_user",
    "password": "db_password"
  },
  "smtp": {
    "host": "smtp.gmail.com",
    "port": 587,
    "username": "notifications@example.com",
    "password": "email_password"
  },
  "test_users": [
    {
      "username": "test_user_1",
      "password": "Test@123",
      "role": "admin"
    },
    {
      "username": "test_user_2",
      "password": "Test@456",
      "role": "viewer"
    }
  ]
}
