# Security and sensitive configuration files
passwords.txt
credentials.txt
config.json
config.json.*
*.key
*.pem
*.cert
.env
.env.*
.env.local
.env.*.local

# Python virtual environments
.venv/
venv/
ENV/
env/
.conda/

# Python bytecode, caches, and test states
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.cache/
.coverage
.coverage.*
htmlcov/
allure-results/
allure-report/

# Local framework run logs
logs/
*.log

# FitNesse local run history, logs, and generated HTML reports
# (keeps your GitHub repository pristine and lightweight!)
FitNesseRoot/files/testResults/
FitNesseRoot/ErrorLogs/
FitNesseRoot/files/reports/
FitNesseRoot/update_history.txt

# Test data JSON files (request/response captures)
FitNesseRoot/files/test_data/
*.test_data.json

# FitNesse backup zip files (created automatically)
FitNesseRoot/**/*.zip
*.zip

# Temporary files
runtime/
temp_*.html
temp_*.txt
temp_check.html
FitNesseRoot/RerunLastFailures_*.wiki
RerunLastFailures_*.wiki
*.tmp
*.bak
*.orig
*.rej

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS-specific temp files
.DS_Store
Thumbs.db

# Local databases / generated runtime artifacts
*.sqlite3
*.db
*.sqlite

# QA automation artifacts
playwright-report/
trace.zip

