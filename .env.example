# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git!

# ⚠️ IMPORTANT: passwords.txt File Format
# FitNesse's PasswordFile does NOT support comment lines (#)
# The passwords.txt file should ONLY contain username:password pairs
# Example:
#   admin:admin123
#   qa:qa123
# 
# For production, use environment variables below instead of passwords.txt

# API Authentication
API_ADMIN_USER=admin
API_ADMIN_PASS=changeme123!
API_QA_USER=qa
API_QA_PASS=changeme456!
API_DEV_USER=dev
API_DEV_PASS=changeme789!
API_READER_USER=reader
API_READER_PASS=readonly123!

# OAuth2 Configuration
OAUTH2_CLIENT_ID=your_client_id_here
OAUTH2_CLIENT_SECRET=your_client_secret_here
OAUTH2_TOKEN_URL=https://auth.example.com/oauth/token

# API Base URLs (Environment-specific)
DEV_BASE_URL=https://dev-api.icici.com
STAGING_BASE_URL=https://staging-api.icici.com
UAT_BASE_URL=https://uat-api.icici.com
PROD_BASE_URL=https://api.icici.com

# Database Configuration (Optional)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=testdb
DB_USER=dbuser
DB_PASSWORD=changeme!

# Framework Configuration
DEFAULT_TIMEOUT=15
MAX_RETRIES=3
RETRY_DELAY=1.0
SSL_VERIFY=true

# Encryption Key (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=generate_your_own_key_here

# Logging Configuration
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=7

# Mock Server
MOCK_SERVER_PORT=8089

# Notification Settings (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_FROM=noreply@icici.com
EMAIL_TO=qa-team@icici.com
