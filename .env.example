# ═════════════════════════════════════════════════════════════════════
# ICICI NIRIKSHAN AUTOMATION FRAMEWORK - ENVIRONMENTAL CONFIG TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual values. NEVER commit .env!
# ═════════════════════════════════════════════════════════════════════

# API Admin Credentials
API_ADMIN_USER=admin
API_ADMIN_PASS=changeme123!

# API QA/Test Credentials
API_QA_USER=qa
API_QA_PASS=changeme456!

# API Dev/Viewer Credentials
API_DEV_USER=dev
API_DEV_PASS=changeme789!

# API Reader/Auditor Credentials
API_READER_USER=reader
API_READER_PASS=readonly123!

# OAuth2 Authentication Config
OAUTH2_CLIENT_ID=your_client_id_here
OAUTH2_CLIENT_SECRET=your_client_secret_here
OAUTH2_TOKEN_URL=https://auth.example.com/oauth/token

# Database Configurations
DB_HOST=localhost
DB_PORT=1433
DB_NAME=testdb
DB_USER=dbuser
DB_PASSWORD=changeme!

# Playwright UI Automation Configurations
UI_BROWSER=chromium
UI_HEADLESS=true
UI_WORKERS=1

# Global Request Core Configurations
DEFAULT_TIMEOUT=15
MAX_RETRIES=3
RETRY_DELAY=1.0
SSL_VERIFY=true

# Central Token Encryption Key (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=generate_your_own_key_here

# Logging Configurations & Log Files Cleanup Retention (Set to 1 to keep exactly 1 day)
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=7

# Mock Server Listening Port
MOCK_SERVER_PORT=8089
