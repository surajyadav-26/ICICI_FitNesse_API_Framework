<script>
$(document).ready(function(){

	let offsettop = $('#ErrSearchbtn').offset().top - 20 +'px';
	$('.search-input').css('top', offsettop);
	if($(window).width() < 768)
	{
		$('#search-input-field').css('display','inline-block');
	}
	$('#ErrSearchbtn').on('click', function(){
		if($(window).width() > 768)
		{
			if($('.search-tab').prop('value') != '')
			{
				window.location = 'https://www.iciciprulife.com/search.html?q='+$('.search-tab').prop('value')+'&tag=icici-pru%3AAll';
			}
			else{
				alert('Invalid Query');
			}
			$('#search-input-field').css('display','none');
		}
		else{
			$('#search-input-field').css('display','inline-block');
			if($('#search-input-field').val() != '')
			{
				window.location = 'https://www.iciciprulife.com/search.html?q='+$('#search-input-field').val()+'&tag=icici-pru%3AAll';
			}
			else{
				alert('Invalid Query');
			}
		}
	});
});
</script>
