		<script>
			$(document).ready(function(){
				var winHeight = $(window).height();
				$('#bannerPopup .modalbox1').css('height', winHeight - 100);
			   });

			function loginDropDown(){
				   if($('#login-type').val()=='Advisor'){
					  $('#advisorPopup').appendTo("body").modal('show');
					} 
				  else  if($('#login-type').val()=='Employee'){
					$('#employeePopup').appendTo("body").modal('show'); 
					}
				  else  if($('#login-type').val()=='Partner'){
					$('#partnerPopup').appendTo("body").modal('show'); 
					} 
				   else{ 
					  window.location.href=$('#login-type').val();
				   }
			}
        function closeLoginClick(){
            $('#login-type').val('#!');
        }
		</script>
