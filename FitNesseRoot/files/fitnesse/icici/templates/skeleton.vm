<!DOCTYPE html>
<html>
 <head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <title>ICICI Nirikshan-$title</title>
  <script>
   (function() {
    var path = location.pathname;
    if (path === "/Home" || path === "/home") {
      location.replace("/FrontPage" + location.search + location.hash);
      return;
    }
    document.addEventListener("DOMContentLoaded", function() {
      if (!/Page doesn't exist/i.test(document.title)) { return; }
      var name = path.replace(/^\//, "");
      if (!name || name.indexOf("/") > -1 || name.indexOf("FrontPage.") === 0) { return; }
      var target = "/FrontPage." + name;
      fetch(target, { credentials: "same-origin" }).then(function(r) { return r.text(); }).then(function(text) {
        var found = /<title>([^<]*)<\/title>/i.exec(text);
        if (found && !/Page doesn't exist/i.test(found[1])) { location.replace(target + location.search + location.hash); }
      }).catch(function() {});
    });
   })();
  </script>
