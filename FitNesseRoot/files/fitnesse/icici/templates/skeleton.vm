 <body#if( $bodyClass ) class="$bodyClass"#end>

  ## ICICI theme: FitNesse default nav removed.
  ## All navigation (Home, Run Suite, Edit, Tools…) is rendered by
  ## FitNesseRoot/PageHeader/content.txt as a branded banner.

  <header>
   #parse( $headerTemplate )
  </header>

  <article>
   #parse( $mainTemplate )
  </article>

  #if( $!footerTemplate )
  <footer>
   #parse( $footerTemplate )
